<Window x:Class="WPFregiszracio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFregiszracio"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="500"
        WindowStartupLocation="CenterScreen" BorderBrush="LightGray"
        BorderThickness="5">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                Margin="0 30 0 10"
                VerticalAlignment="Center"
                Width="400">
        <TextBlock Text="Regisztráció"
                   FontSize="36"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Kérlek add meg az adataidat"
                   Foreground="Gray"
                   FontSize="13"
                   HorizontalAlignment="Center"/>
        <StackPanel>
            <Label Content="Név:"
                   FontSize="15"/>
            <TextBox FontSize="16"
                     Padding="0 5"
                     Name="tbx_nev"/>
        </StackPanel>
        <StackPanel Margin="0 15 0 0">
            <Label Content="E-mail:"
                   FontSize="15"/>
            <TextBox FontSize="16"
                     Padding="0 5"
                     Name="tbx_email"
                     LostFocus="tbx_email_LostFocus"/>
        </StackPanel>
        <StackPanel Margin="0 15 0 0">
            <Label Content="Jelszó:"
                   FontSize="15"/>
            <TextBox FontSize="16"
                     Padding="0 5"
                     Name="tbx_jelszo1"
                     LostFocus="tbx_jelszo1_LostFocus"/>
        </StackPanel>
        <StackPanel Margin="0 15 0 0">
            <Label Content="Jelszó megerősítése:"
                   FontSize="15"/>
            <TextBox FontSize="16"
                     Padding="0 5"
                     Name="tbx_jelszo2"/>
        </StackPanel>
        <StackPanel Margin="0 10 0 20">
            <CheckBox Content="Elfogadom a felhasználási feltételeket"
                      Name="feltetel"/>
        </StackPanel>
        <Button Name="btn_regisztracio"
                Content="Regisztráció"
                Padding="0 10"
                Background="Black"
                Foreground="White"
                FontSize="16"
                FontWeight="Bold"
                Click="btn_regisztracio_Click"/>
        <StackPanel Orientation="Horizontal"
                    Margin="0 5"
                    HorizontalAlignment="Center">
            <TextBlock Text="Már van fiókod?"
                       Margin="0 0 5 0"/>
            <TextBlock>
                <Hyperlink>Jelentkezz be</Hyperlink>
            </TextBlock>
        </StackPanel>

    </StackPanel>
</Window>
